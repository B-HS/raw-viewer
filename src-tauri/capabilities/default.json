{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Default capability for the main window and per-file secondary windows",
    "windows": ["main", "window-*"],
    "permissions": [
        "core:default",
        "dialog:default",
        "opener:allow-reveal-item-in-dir",
        {
            "identifier": "opener:allow-open-url",
            "allow": [{ "url": "https://www.google.com/maps/**" }, { "url": "https://maps.apple.com/**" }]
        },
        "store:allow-load",
        "store:allow-get",
        "store:allow-set",
        "store:allow-save",
        "updater:default",
        "process:allow-restart",
        "core:window:allow-close",
        "core:window:allow-destroy",
        "core:window:allow-minimize",
        "core:window:allow-toggle-maximize",
        "core:window:allow-is-maximized",
        "core:window:allow-start-dragging"
    ]
}
